{
    "name": "api-platform/versioning",
    "description": "Experimental backward-compatible API versioning driven by declarative Overlay-based mutators.",
    "type": "library",
    "keywords": [
        "REST",
        "API",
        "OpenAPI",
        "Overlay",
        "versioning"
    ],
    "homepage": "https://api-platform.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Kévin Dunglas",
            "email": "kevin@dunglas.fr",
            "homepage": "https://dunglas.fr"
        },
        {
            "name": "API Platform Community",
            "homepage": "https://api-platform.com/community/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "api-platform/metadata": "^5.0@alpha",
        "psr/container": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.2",
        "api-platform/state": "^5.0@alpha",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/serializer": "^7.4 || ^8.0"
    },
    "suggest": {
        "api-platform/state": "To integrate versioning with the Symfony serializer context builder.",
        "symfony/http-foundation": "To use the default header-based version resolver (already available on Symfony, and on Laravel whose request extends the HttpFoundation request).",
        "symfony/http-kernel": "To negotiate the version on the request and add discoverability headers to the response under Symfony.",
        "symfony/serializer": "To downgrade responses at serialization time via the version-mutation normalizer."
    },
    "autoload": {
        "psr-4": {
            "ApiPlatform\\Versioning\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.0.x-dev"
        },
        "symfony": {
            "require": "^7.4 || ^8.0"
        },
        "thanks": {
            "name": "api-platform/api-platform",
            "url": "https://github.com/api-platform/api-platform"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
